# Copia este archivo como ".env" y llena tus datos. NUNCA subas el .env a GitHub.

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USUARIO=root
DB_CONTRASENA=
DB_NOMBRE=mediturno
# Pon "true" si tu hosting de MySQL exige conexión segura (SSL)
DB_SSL=false

# --- Seguridad ---
# Texto largo y secreto para firmar sesiones (inventa uno)
SECRETO=cambia-esto-por-un-texto-largo-y-secreto
# Correo ÚNICO del administrador (entra con un código que le llega al correo)
ADMIN_EMAIL=tu_correo@gmail.com

# --- Correos (Resend). Sin llave, los correos salen en la terminal ---
RESEND_API_KEY=
# Solo si verificaste un dominio. Ejemplo: MediTurno <citas@tudominio.com>
CORREO_DE=

# --- Chatbot con IA (Anthropic). Sin llave, responde un asistente básico ---
ANTHROPIC_API_KEY=

# --- Publicación ---
# Dirección pública de la página (para los enlaces de los correos). Ejemplo: https://mediturno.onrender.com
URL_PUBLICA=
# "si" crea doctores y un paciente de prueba la primera vez
DATOS_PRUEBA=si
